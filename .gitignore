# Rust
/target
**/*.rs.bk

# Native shells
apps/android/.gradle
apps/android/build
apps/android/app/build
apps/android/local.properties
# The key of the signing of the release is a secret and never belongs into
# the repository. The properties that name it are read from the machine of
# the owner of the key.
apps/android/keystore.properties
*.jks
*.keystore
apps/macos/.build
apps/macos/Package.resolved

# Web dashboard
apps/web/node_modules
apps/web/dist
apps/web/.vite

# Editors and operating systems
.DS_Store
.idea/
.vscode/
*.swp

# Local artefacts
*.log
# WHY: the logs of the audit records are the *evidence* of the acceptance,
# and they belong in the repository. Every other log stays out.
!docs/audit/*.log
.env
.env.*

# The workspace of the agent team is not part of the project.
.mavis/
