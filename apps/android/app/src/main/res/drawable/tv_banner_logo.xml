<?xml version="1.0" encoding="utf-8"?>
<!--
    The sign of the shell in the banner of the television.

    WHAT: a screen with a play mark in it and a foot underneath.

    WHY: the banner of a Leanback application is shown by the launcher of
    the television, next to the name of the application. The sign has to
    say "this is a receiver" in one glance, and it has to survive being
    scaled down to a small icon.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="96dp"
    android:height="96dp"
    android:viewportWidth="96"
    android:viewportHeight="96">

    <!-- The screen of the television. -->
    <path
        android:fillColor="#FF60A5FA"
        android:fillType="evenOdd"
        android:pathData="M16,26h64a6,6 0 0 1 6,6v32a6,6 0 0 1 -6,6h-64a6,6 0 0 1 -6,-6v-32a6,6 0 0 1 6,-6zM22,32v32h52v-32z" />

    <!-- The play mark of the stream that the receiver shows. -->
    <path
        android:fillColor="#FF4ADE80"
        android:pathData="M40,38l18,10l-18,10z" />

    <!-- The foot of the television. -->
    <path
        android:fillColor="#FFA9B4C2"
        android:pathData="M40,76h16v6h-16zM28,82h40v5h-40z" />

</vector>
