<?xml version="1.0" encoding="utf-8"?>
<!--
    The rules of the backup of the application.

    WHY: the application keeps the pairing secrets of the sender devices and
    nothing else that belongs to the user. A backup would carry those
    secrets onto another device, so the rules exclude everything.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
