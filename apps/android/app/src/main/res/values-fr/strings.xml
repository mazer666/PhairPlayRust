<?xml version="1.0" encoding="utf-8"?>
<!--
    Les textes de l'interface Android en français.

    WHY: l'interface se commande à la télécommande et se lit à trois
    mètres. Les textes français sont donc des phrases complètes quand
    l'utilisateur doit agir, et les mots des états sont assez courts
    pour être lus d'un coup d'œil.

    Les apostrophes sont échappées, parce que l'outil de compilation des
    ressources Android les refuse autrement.
-->
<resources>

    <string name="app_name">PhairPlayRust</string>

    <!-- L\'en-tête du tableau de bord. -->
    <string name="dashboard_title">Récepteur</string>
    <string name="dashboard_device_unknown">En attente du nom de l\'appareil</string>
    <string name="dashboard_version">Version %1$s</string>
    <string name="dashboard_receiver_running">Le récepteur fonctionne</string>
    <string name="dashboard_receiver_stopped">Le récepteur ne fonctionne pas</string>
    <string name="dashboard_receiver_waiting">Le récepteur démarre</string>
    <string name="dashboard_dpad_help">Choisir avec les flèches, appuyer sur OK pour activer</string>
    <string name="dashboard_waiting_protocols">Les protocoles apparaissent dès que le récepteur a répondu.</string>

    <!-- La carte d\'un protocole. -->
