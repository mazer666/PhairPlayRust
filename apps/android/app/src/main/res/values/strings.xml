<?xml version="1.0" encoding="utf-8"?>
<!--
    The texts of the Android shell.

    WHY: every text the user can read lives here and nowhere else. A text
    that is written into the source of a screen cannot be translated, and
    it cannot be reviewed by somebody who does not read Kotlin.

    The strings of the dashboard are written for a television: they are
    read from three metres, with a remote control in the hand. Every text
    that a user has to *act* on is therefore a full sentence, and the
    texts of the state of a protocol are short enough to be read at a
    glance.
-->
<resources>

    <string name="app_name">PhairPlayRust</string>

    <!-- The head of the dashboard. -->
    <string name="dashboard_title">Receiver</string>
    <string name="dashboard_device_unknown">Waiting for the name of the device</string>
    <string name="dashboard_version">Version %1$s</string>
    <string name="dashboard_receiver_running">The receiver is running</string>
    <string name="dashboard_receiver_stopped">The receiver is not running</string>
    <string name="dashboard_receiver_waiting">The receiver is starting</string>
    <string name="dashboard_dpad_help">Use the arrow keys to choose, press OK to switch</string>
    <string name="dashboard_waiting_protocols">The protocols appear as soon as the receiver has answered.</string>

