<?xml version="1.0" encoding="utf-8"?>
<!--
    The texts of the Android shell.

    WHY: every text the user can read lives here and nowhere else. A text
    that is written into the source of a screen cannot be translated, and
    it cannot be reviewed by somebody who does not read Kotlin.
-->
<resources>

    <string name="app_name">PhairPlayRust</string>

    <!-- The head of the dashboard. -->
    <string name="dashboard_title">Receiver</string>
    <string name="dashboard_device">Device: %1$s</string>
    <string name="dashboard_version">Version %1$s</string>
    <string name="dashboard_receiver_running">The receiver is running.</string>
    <string name="dashboard_receiver_stopped">The receiver is not running.</string>
    <string name="dashboard_start_receiver">Start the receiver</string>
    <string name="dashboard_stop_receiver">Stop the receiver</string>

    <!-- The card of one protocol. -->
    <string name="protocol_card_ports">TCP %1$s · UDP %2$s</string>
    <string name="protocol_card_ports_tcp_only">TCP %1$s</string>
    <string name="protocol_card_no_port">No port is bound</string>
    <plurals name="protocol_card_peers">
        <item quantity="one">%1$d sender</item>
        <item quantity="other">%1$d senders</item>
    </plurals>
    <string name="protocol_switch_on">Switch %1$s on</string>
    <string name="protocol_switch_off">Switch %1$s off</string>

    <!-- The state of a protocol. -->
    <string name="protocol_state_disabled">Disabled in the settings</string>
    <string name="protocol_state_disabled_reason">The service is not advertised at all.</string>
    <string name="protocol_state_not_started">Not started</string>
    <string name="protocol_state_not_started_reason">The protocol is switched on, but the service has never run.</string>
    <string name="protocol_state_stopped">Service stopped</string>
    <string name="protocol_state_stopped_reason">The protocol is switched on, but the service is not running.</string>
    <string name="protocol_state_starting">Starting</string>
    <string name="protocol_state_starting_reason">The sockets are bound and the service is registered.</string>
    <string name="protocol_state_advertising">Advertising</string>
    <string name="protocol_state_advertising_reason">Visible to the senders of the local network, waiting for a connection.</string>
    <string name="protocol_state_streaming">Streaming</string>
    <string name="protocol_state_streaming_reason">A sender is connected and the stream is running.</string>
    <string name="protocol_state_stopping">Stopping</string>
    <string name="protocol_state_stopping_reason">The connection to the sender is being closed.</string>
    <string name="protocol_state_failed">Error</string>
    <string name="protocol_state_failed_reason">The receiver could not be started.</string>

    <!-- The view of the running session. -->
    <string name="now_playing_title">Now playing</string>
    <string name="now_playing_empty">No sender is connected.</string>
    <string name="now_playing_sender_unknown">Unknown sender</string>
    <string name="now_playing_video_unknown">No video</string>
    <string name="now_playing_audio_unknown">No audio</string>
    <string name="now_playing_video_format">Video: %1$s</string>
    <string name="now_playing_audio_format">Audio: %1$s</string>
    <string name="now_playing_uptime">Running for %1$s</string>
    <string name="now_playing_title_unknown">Unknown title</string>
    <string name="now_playing_artist_unknown">Unknown artist</string>
    <string name="now_playing_album_unknown">Unknown album</string>
    <string name="now_playing_artwork">The artwork of the sender</string>

    <!-- The notification of the foreground service. -->
    <string name="notification_channel_name">Receiver</string>
    <string name="notification_channel_description">Shows that the receiver is running and which sender is connected.</string>
    <string name="notification_title">PhairPlayRust receiver</string>
    <string name="notification_text_idle">Waiting for a sender</string>
    <string name="notification_text_session">%1$s is sending</string>
    <string name="notification_action_stop">Stop</string>

    <!-- The failure of the bridge. -->
    <string name="failure_title">The receiver reported a problem</string>
    <string name="failure_code">Code %1$d</string>
    <string name="failure_dismiss">Dismiss</string>

    <!-- The platform of the device. -->
    <string name="capability_missing_miracast">This device has no Wi-Fi Direct radio. Miracast cannot work here.</string>
    <string name="capability_missing_multicast">This device does not allow multicast. The discovery of the protocols cannot work here.</string>

    <!-- The names of the protocols. -->
    <string name="protocol_airplay">AirPlay 2</string>
    <string name="protocol_miracast">Miracast</string>
    <string name="protocol_cast">Google Cast</string>
    <string name="protocol_dlna">DLNA / UPnP</string>

</resources>
