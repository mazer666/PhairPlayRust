<?xml version="1.0" encoding="utf-8"?>
<!--
    The colours of the platform theme.

    WHY: the window of the application is drawn by Compose, but the window
    itself is created by the platform before the first frame of Compose
    exists. Without these colours the window flashes in the wrong colour
    while the process starts.

    The background is dark, because the shell is read on a television in a
    living room: a dark surface does not glare in a dark room and it lets
    the focus frame of the keyboard navigation stand out.
-->
<resources>

    <color name="background">#FF0E1116</color>
    <color name="launcher_background">#FF1F2933</color>
    <color name="banner_background">#FF0E1116</color>

</resources>
